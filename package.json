{
  "name": "growth-pilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @growthpilot/web",
    "dev:api": "npm run start:dev --workspace @growthpilot/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migration:dry-run": "node scripts/migration/run-staging-import.mjs --dry-run",
    "ci:check": "npm run lint && npm run typecheck && npm run test",
    "smoke:api": "cd apps/api && node -e \"require('./dist/main')\" || echo 'dist not built, run npm run build first'",
    "dev:all": "npm run dev:web & npm run dev:api",
    "clean": "rm -rf apps/*/dist apps/*/.next apps/*/tsconfig.tsbuildinfo packages/*/dist"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "typescript": "^5.8.2"
  }
}
