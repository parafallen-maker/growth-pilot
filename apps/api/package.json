{
  "name": "@growthpilot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "start:worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "node -e \"console.log('api format placeholder')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:worker": "tsx src/worker.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "validate:live:be23-be25": "node --import tsx test/be23-be25.live.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.1.17",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.7.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.3"
  }
}
