{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Web App",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "API Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "API Worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api:worker"]
    }
  ]
}
