NODE_ENV=production

# Public entrypoints
CORS_ORIGIN=https://your-domain.com
API_BASE_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1
GROWTHPILOT_API_BASE_URL=http://api:3000/api/v1

# API runtime
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
GP_PERSISTENCE_ADAPTER=db

# The API still writes file-backed state under apps/api/.data and apps/api/.runtime.
OBJECT_STORAGE_DRIVER=local
GROWTHPILOT_MASTER_DATA_PATH=.runtime/master-data.json

# PostgreSQL
POSTGRES_DB=growthpilot
POSTGRES_USER=gp
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql://gp:REPLACE_WITH_STRONG_PASSWORD@db:5432/growthpilot

# Redis
REDIS_URL=redis://redis:6379

# MinIO is provisioned for future S3-compatible storage wiring.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
S3_BUCKET=growthpilot

# AI provider (homework analysis uses an OpenAI-compatible chat/completions endpoint)
AI_PROVIDER=openai
AI_MODEL_HOMEWORK=gpt-4o-mini
AI_MODEL_REPORT=gpt-4o-mini
AI_PROMPT_VERSION_HOMEWORK=homework-review-v3
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=REPLACE_WITH_REAL_PROVIDER_KEY

# Published ports
NGINX_PORT=80
MINIO_CONSOLE_PORT=9001
